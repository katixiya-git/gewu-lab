# 运行环境
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# MySQL（事务数据：用户、实验室、设备、预约）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gewu

# Redis（向量索引 / LangGraph checkpoint / 缓存）
REDIS_URL=redis://127.0.0.1:6379/0

# 模型（百炼 OpenAI 兼容接口）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen-plus
