# MySQL（事务数据：用户、实验室、设备、预约）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gewu

# Redis（LangGraph checkpoint / 缓存）
# 虚拟机里的 Redis Stack：宿主机可用 your-redis-host 访问
REDIS_URL=redis://127.0.0.1:6379/0
# 未设密码留空；设了密码填这里，客户端会先 AUTH
REDIS_PASSWORD=

# 模型（百炼 OpenAI 兼容接口）
AI_ENABLED=true
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60
AI_MAX_HISTORY_MESSAGES=20

# AI 会话状态
AI_THREAD_TTL_SECONDS=86400
AI_CHECKPOINT_PREFIX=gewu:ai

# ---- 文件上传 ----
# 相对启动目录（backend/）；public/ 由 /media 静态托管，private/ 走 /api/files/{id}/download 鉴权
UPLOAD_DIR=uploads
# 单文件大小上限（MB），超过直接 400
UPLOAD_MAX_MB=20

# ---- 知识库 ----
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=80
KB_TOP_K=5
KB_MIN_SIMILARITY=0.20
# 一般不用改：索引名/键前缀/语料目录/向量模型与维度/批大小
KB_INDEX_NAME=idx:gewu_kb
KB_KEY_PREFIX=gewu:kb:
KB_DOCS_DIR=docs/knowledge
KB_EMBEDDING_MODEL=text-embedding-v3
KB_EMBEDDING_DIM=1024
KB_EMBED_BATCH_SIZE=10

# JWT（登录签发，生产环境务必换成随机长字符串）
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 允许跨域的前端来源（逗号分隔；开发期前端走 Vite 代理，通常用不到）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
